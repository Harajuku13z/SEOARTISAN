# ARTISAN IA PRO - front controller rewrite (Apache / mod_rewrite)
# Nginx equivalent documented in docs/installation.md

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files/directories (assets, uploads) as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller. No .php in URLs.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes

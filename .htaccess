# OVH shared-hosting front controller. The subdomain document root is this
# directory, while the public application entry point stays in /public.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]
    RewriteRule ^sitemap\.xml$ public/sitemap.xml [L]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^wordpress(?:/|$) - [L]

    # ACME/OVH validation files must remain directly reachable.
    RewriteRule ^\.well-known/ - [L]

    # Legacy Laravel URLs kept during the JC TOITURES migration.
    RewriteRule ^legal/mentions/?$ /mentions-legales [R=301,L]
    RewriteRule ^legal/privacy/?$ /politique-confidentialite [R=301,L]
    RewriteRule ^legal/cgv/?$ /conditions-generales-vente [R=301,L]

    # Never expose application source or configuration files.
    RewriteRule ^(?:app|config|database|resources|routes|scripts|storage|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:bootstrap\.php|composer\.(?:json|lock)|\.env(?:\.example)?|README\.md|phpunit\.xml)$ - [F,L,NC]

    RewriteRule ^ public/index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
